# Dify API Keys Configuration
# Format: Comma-separated list of API keys
DIFY_API_KEYS=app-xxxxxxxxxxxxxxxx,app-yyyyyyyyyyyyyyyy,app-zzzzzzzzzzzzzzzz

# Dify API Base URL
DIFY_API_BASE="https://api.dify.example.com/v1"

# 会话记忆功能模式
# 1: 构造全量历史消息附加到请求中的模式（默认）
# 2: 基于 conversation_id（请求头 X-Dify-Conversation-Id 或请求体 conversation_id）的增量上下文模式
CONVERSATION_MEMORY_MODE=1

# Server Configuration
SERVER_HOST="127.0.0.1"
SERVER_PORT=5000
WORKERS=1
TIMEOUT=300.0
LOG_LEVEL="WARNING"

# OpenAI Compatible API Keys & Auth
# AUTH_MODE: required (默认，校验 Authorization / X-API-Key) 或 disabled (关闭鉴权)
AUTH_MODE="required"
VALID_API_KEYS="sk-abc123,sk-def456"

# Tool Calling & Streaming Configuration
TOOL_SUPPORT=true
TOOL_BUFFER_LIMIT=2000000
DIFY_FORCE_STREAMING=true
MAX_FILES_PER_REQUEST=10
DIFY_SSL_VERIFY=true

# Optional: Claude / Anthropic Compatibility Configuration
# CLAUDE_MODEL_MAP="claude-3-5-sonnet-20241022:My Dify App"
# CLAUDE_DEFAULT_MODEL=""
# ANTHROPIC_API_BASE="https://api.anthropic.com"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=""
# ANTHROPIC_VERSION="2023-06-01"
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_SSL_VERIFY=true

# Optional: Upstream OpenAI Pass-through for /anthropic/v1/messages
# UPSTREAM_OPENAI_BASE_URL=""
# UPSTREAM_OPENAI_API_KEY=""
# UPSTREAM_OPENAI_MODEL=""
# UPSTREAM_OPENAI_MODEL_MAP=""
# UPSTREAM_OPENAI_MAX_TOKENS=1024
# UPSTREAM_OPENAI_SSL_VERIFY=true
